#################
#
# Primary .gitignore for this single-module Maven project (shape: cumba-corej-rest).
#
#################

# Eclipse
**/.settings/
**/.project
**/.classpath

# IntelliJ
**/.idea/
**/*.iml

# VS Code
**/.vscode/

# Maven
**/target/

# Pitest incremental-analysis history files (generated; cached by CI)
/.pitest-history/

# ---> Java
**/*.class

# Package files
**/*.jar
**/*.war
**/*.ear
**/*.dll
**/*.so
**/*.dylib

# OS-level cruft
**/.DS_Store
# JVM crash logs — see https://www.java.com/en/download/help/error_hotspot.xml
**/hs_err_pid*

# Claude Code working dir
**/.claude

# Generic build output
**/bin/
/build_logs/

# .env files (any module / sub-dir)
**/.env

# Python helper caches (if scripts/ uses them)
__pycache__/
.pytest_cache/

# flattened pom output (flatten-maven-plugin)
**/.flattened-pom.xml

# Locally resolved third-party licenses (regenerated by license-maven-plugin)
/src/license/licenses

# The default editor.workspace-root of a local run: per-user clones of the rule
# repository (and the optional anonymous clone). Runtime state, never committed.
/workspaces/
