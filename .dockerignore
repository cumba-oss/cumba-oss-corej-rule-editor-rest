# The build stage compiles from the SOURCES (Dockerfile): send the repo, minus build output
# (a stale target/ must never reach the image), git metadata and IDE files.
target/
.git
.gitea/
.idea/
.vscode/
.settings/
.classpath
.project
*.iml
.flattened-pom.xml

# The release zip CI downloads for Dockerfile.runtime (publish-image job). The image takes the
# unpacked copy from image-ctx/, so the zip itself must never enter the build context.
release-archives/
