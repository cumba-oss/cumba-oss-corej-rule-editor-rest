# Default: treat every file as text, auto-detect, normalize working-tree
# checkouts to LF. Anything explicitly listed below overrides this.
* text=auto eol=lf

# Source and configuration — explicit LF.
*.java   text eol=lf
*.kt     text eol=lf
*.groovy text eol=lf
*.scala  text eol=lf
*.xml    text eol=lf
*.xsd    text eol=lf
*.xsl    text eol=lf
*.xslt   text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.properties text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.py     text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.svg    text eol=lf

# Windows-specific scripts — keep CRLF so they run correctly on Windows.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary formats — never line-end normalize.
# Add project-specific binary extensions below the generic block as
# needed (e.g. *.parquet, *.sas7bdat, model checkpoints, …).
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.pdf    binary
*.zip    binary
*.jar    binary
*.war    binary
*.ear    binary
*.class  binary
*.so     binary
*.dll    binary
*.dylib  binary
*.exe    binary
*.bin    binary
*.dat    binary
*.xlsx   binary
*.xls    binary
*.ipynb  binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
